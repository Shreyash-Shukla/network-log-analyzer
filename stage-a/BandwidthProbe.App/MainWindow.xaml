<Window x:Class="BandwidthProbe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bandwidth Probe — Stage A" Height="690" Width="1000" MinHeight="500" MinWidth="760">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Bandwidth measurement probe" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Plain test interface. Values are network bytes, not ISP billing." Margin="0,2,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="StartButton" Content="Start" Width="90" Click="Start_Click"/>
                <Button x:Name="PauseButton" Content="Pause" Width="90" Margin="8,0,0,0" Click="Pause_Click"/>
                <Button x:Name="ExportButton" Content="Pause &amp; export JSONL" Width="160" Margin="8,0,0,0" Click="Export_Click"/>
                <TextBlock x:Name="StatusText" Text="Paused" Margin="20,4,0,0"/>
            </StackPanel>
            <Border x:Name="GapBanner" Background="#FFFFD9D9" Padding="8" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock x:Name="GapText" Text="Data gap: measurements may be incomplete." TextWrapping="Wrap"/>
            </Border>
            <TextBlock x:Name="RateText" FontSize="16" Text="Download 0 B/s    Upload 0 B/s" Margin="0,0,0,6"/>
            <TextBlock x:Name="CounterText" Text="Events: 0    Lost: 0    Parse failures: 0    Export drops: 0" Margin="0,0,0,10"/>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
            <GroupBox Header="Processes — session totals" Grid.Row="0" Margin="0,0,0,8">
                <DataGrid x:Name="ProcessGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="App / process" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="90"/>
                        <DataGridTextColumn Header="Downloaded" Binding="{Binding Download}" Width="130"/>
                        <DataGridTextColumn Header="Uploaded" Binding="{Binding Upload}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Header="Adapters — session totals (separate counter source)" Grid.Row="1">
                <DataGrid x:Name="AdapterGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Adapter" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140"/>
                        <DataGridTextColumn Header="Downloaded" Binding="{Binding Download}" Width="130"/>
                        <DataGridTextColumn Header="Uploaded" Binding="{Binding Upload}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
